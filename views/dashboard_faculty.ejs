<%- include('partials/header', { title: 'Faculty Dashboard' }) %>

<div class="dash-page dash-accent-faculty">

  <!-- ================= WELCOME BAND ================= -->
  <section class="dash-welcome dash-welcome-faculty dash-anim" style="--i:0">
    <div class="dash-welcome-main">
      <img src="<%= avatarUrl(currentUser) %>" alt="avatar" class="dash-welcome-avatar">
      <div class="dash-welcome-text">
        <p class="dash-welcome-date">
          <i class="bi bi-calendar3"></i> <%= new Date().toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %>
        </p>
        <h2 class="dash-welcome-title">Hello, <%= currentUser.name %> <i class="bi bi-person-video3"></i></h2>
        <p class="dash-welcome-sub">
          Faculty Dashboard
          <% if (profile && profile.department) { %> · <%= profile.department %> Department<% } %>
        </p>
      </div>
    </div>
    <div class="dash-welcome-actions">
      <a href="/announcements" class="btn dash-btn-light">
        <i class="bi bi-megaphone"></i> New Announcement
      </a>
      <a href="/search" class="btn dash-btn-ghost">
        <i class="bi bi-search"></i> Member Directory
      </a>
    </div>
  </section>

  <!-- ================= STATS ================= -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-lg-3 dash-anim" style="--i:1">
      <div class="dash-stat">
        <div class="dash-stat-icon dash-stat-blue"><i class="bi bi-mortarboard"></i></div>
        <div><div class="dash-stat-num"><span class="counter" data-count="<%= stats.students %>"><%= stats.students %></span></div>
        <div class="dash-stat-label">Students</div></div>
      </div>
    </div>
    <div class="col-6 col-lg-3 dash-anim" style="--i:2">
      <div class="dash-stat">
        <div class="dash-stat-icon dash-stat-green"><i class="bi bi-award"></i></div>
        <div><div class="dash-stat-num"><span class="counter" data-count="<%= stats.alumni %>"><%= stats.alumni %></span></div>
        <div class="dash-stat-label">Alumni</div></div>
      </div>
    </div>
    <div class="col-6 col-lg-3 dash-anim" style="--i:3">
      <div class="dash-stat">
        <div class="dash-stat-icon dash-stat-orange"><i class="bi bi-pencil-square"></i></div>
        <div><div class="dash-stat-num"><span class="counter" data-count="<%= stats.myAnnouncements %>"><%= stats.myAnnouncements %></span></div>
        <div class="dash-stat-label">My Announcements</div></div>
      </div>
    </div>
    <div class="col-6 col-lg-3 dash-anim" style="--i:4">
      <div class="dash-stat">
        <div class="dash-stat-icon dash-stat-purple"><i class="bi bi-megaphone"></i></div>
        <div><div class="dash-stat-num"><span class="counter" data-count="<%= stats.announcements %>"><%= stats.announcements %></span></div>
        <div class="dash-stat-label">Total Announcements</div></div>
      </div>
    </div>
  </div>

  <%- include('partials/suggestions') %>

  <!-- ================= QUICK ACTIONS ================= -->
  <div class="row g-3">
    <div class="col-md-4 dash-anim" style="--i:0">
      <a href="/announcements" class="dash-action">
        <span class="dash-action-icon dash-action-orange"><i class="bi bi-megaphone"></i></span>
        <span class="dash-action-text">
          <span class="dash-action-title">Announcements</span>
          <span class="dash-action-desc">Post notices about events, meets and deadlines.</span>
        </span>
        <i class="bi bi-chevron-right dash-action-arrow"></i>
      </a>
    </div>
    <div class="col-md-4 dash-anim" style="--i:1">
      <a href="/search" class="dash-action">
        <span class="dash-action-icon dash-action-blue"><i class="bi bi-search"></i></span>
        <span class="dash-action-text">
          <span class="dash-action-title">Member Directory</span>
          <span class="dash-action-desc">Find students and alumni and view their profiles.</span>
        </span>
        <i class="bi bi-chevron-right dash-action-arrow"></i>
      </a>
    </div>
    <div class="col-md-4 dash-anim" style="--i:2">
      <a href="/chat" class="dash-action">
        <span class="dash-action-icon dash-action-sky"><i class="bi bi-chat-dots"></i></span>
        <span class="dash-action-text">
          <span class="dash-action-title">Messages</span>
          <span class="dash-action-desc">Talk to students and alumni directly.</span>
        </span>
        <i class="bi bi-chevron-right dash-action-arrow"></i>
      </a>
    </div>
    <div class="col-md-4 dash-anim" style="--i:3">
      <a href="/jobs" class="dash-action">
        <span class="dash-action-icon dash-action-green"><i class="bi bi-briefcase"></i></span>
        <span class="dash-action-text">
          <span class="dash-action-title">Job Board</span>
          <span class="dash-action-desc">See the opportunities alumni are offering.</span>
        </span>
        <i class="bi bi-chevron-right dash-action-arrow"></i>
      </a>
    </div>
    <div class="col-md-4 dash-anim" style="--i:4">
      <a href="/connections" class="dash-action">
        <span class="dash-action-icon dash-action-red"><i class="bi bi-people"></i></span>
        <span class="dash-action-text">
          <span class="dash-action-title">Connections</span>
          <span class="dash-action-desc">Accept requests and grow your network.</span>
        </span>
        <i class="bi bi-chevron-right dash-action-arrow"></i>
      </a>
    </div>
    <div class="col-md-4 dash-anim" style="--i:5">
      <a href="/profile/edit" class="dash-action">
        <span class="dash-action-icon dash-action-slate"><i class="bi bi-pencil-square"></i></span>
        <span class="dash-action-text">
          <span class="dash-action-title">Edit Profile</span>
          <span class="dash-action-desc">Update department, qualification and photo.</span>
        </span>
        <i class="bi bi-chevron-right dash-action-arrow"></i>
      </a>
    </div>
  </div>

</div>

<%- include('partials/footer') %>

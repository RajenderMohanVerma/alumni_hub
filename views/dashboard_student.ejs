<%- include('partials/header', { title: 'Student Dashboard' }) %>

<div class="dash-page dash-accent-student">

  <!-- ================= WELCOME BAND ================= -->
  <section class="dash-welcome dash-welcome-student dash-anim" style="--i:0">
    <div class="dash-welcome-main">
      <img src="<%= avatarUrl(currentUser) %>" alt="avatar" class="dash-welcome-avatar">
      <div class="dash-welcome-text">
        <p class="dash-welcome-date">
          <i class="bi bi-calendar3"></i> <%= new Date().toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %>
        </p>
        <h2 class="dash-welcome-title">Hello, <%= currentUser.name %> <i class="bi bi-mortarboard"></i></h2>
        <p class="dash-welcome-sub">
          Student Dashboard
          <% if (profile && profile.course) { %> · <%= profile.course %><% if (profile.branch) { %> (<%= profile.branch %>)<% } %><% } %>
        </p>
      </div>
    </div>
    <div class="dash-welcome-actions">
      <a href="/search" class="btn dash-btn-light">
        <i class="bi bi-search"></i> Find Members
      </a>
      <a href="/profile/edit" class="btn dash-btn-ghost">
        <i class="bi bi-pencil-square"></i> Edit Profile
      </a>
    </div>
  </section>

  <!-- ================= STATS ================= -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-lg-3 dash-anim" style="--i:1">
      <div class="dash-stat">
        <div class="dash-stat-icon dash-stat-blue"><i class="bi bi-people"></i></div>
        <div><div class="dash-stat-num"><span class="counter" data-count="<%= stats.connections %>"><%= stats.connections %></span></div>
        <div class="dash-stat-label">My Connections</div></div>
      </div>
    </div>
    <div class="col-6 col-lg-3 dash-anim" style="--i:2">
      <div class="dash-stat">
        <div class="dash-stat-icon dash-stat-green"><i class="bi bi-briefcase"></i></div>
        <div><div class="dash-stat-num"><span class="counter" data-count="<%= stats.jobs %>"><%= stats.jobs %></span></div>
        <div class="dash-stat-label">Jobs Available</div></div>
      </div>
    </div>
    <div class="col-6 col-lg-3 dash-anim" style="--i:3">
      <div class="dash-stat">
        <div class="dash-stat-icon dash-stat-orange"><i class="bi bi-file-earmark-text"></i></div>
        <div><div class="dash-stat-num"><span class="counter" data-count="<%= stats.applications %>"><%= stats.applications %></span></div>
        <div class="dash-stat-label">My Applications</div></div>
      </div>
    </div>
    <div class="col-6 col-lg-3 dash-anim" style="--i:4">
      <div class="dash-stat">
        <div class="dash-stat-icon dash-stat-purple"><i class="bi bi-megaphone"></i></div>
        <div><div class="dash-stat-num"><span class="counter" data-count="<%= stats.announcements %>"><%= stats.announcements %></span></div>
        <div class="dash-stat-label">Announcements</div></div>
      </div>
    </div>
  </div>

  <%- include('partials/suggestions') %>

  <!-- ============ RECOMMENDED JOBS FOR YOU (KNN-matched) ============ -->
  <section class="mb-4">
    <h4 class="section-title"><i class="bi bi-briefcase text-success"></i> Recommended Jobs for You</h4>
    <% if (jobSuggestions && jobSuggestions.length) { %>
    <div class="row g-3">
      <% jobSuggestions.forEach(function(r, idx) { %>
      <%
        var _h = 0, _c = String(r.job.company || '');
        for (var _i = 0; _i < _c.length; _i++) { _h = (_h * 31 + _c.charCodeAt(_i)) >>> 0; }
        var tileClass = 'dash-job-tile-' + (_h % 6);
      %>
      <div class="col-md-6 col-lg-4 dash-anim" style="--i:<%= idx % 6 %>">
        <div class="card h-100 dash-job-card">
          <div class="card-body d-flex flex-column">
            <div class="d-flex align-items-center gap-3 mb-2">
              <div class="dash-job-tile <%= tileClass %>"><%= (r.job.company || '?').charAt(0).toUpperCase() %></div>
              <div>
                <h5 class="dash-job-title mb-0"><%= r.job.title %></h5>
                <p class="dash-context mb-0">
                  <i class="bi bi-building"></i> <%= r.job.company %>
                  <% if (r.job.location) { %> · <i class="bi bi-geo-alt"></i> <%= r.job.location %><% } %>
                </p>
              </div>
            </div>
            <p class="mb-2">
              <span class="dash-match-pill">
                <i class="bi bi-stars"></i> <%= r.matchPercent %>% match
              </span>
            </p>
            <p class="text-muted small mb-0">
              <i class="bi bi-check2-circle text-success"></i> <%= r.reason %>
            </p>
          </div>
          <div class="card-footer dash-job-footer d-flex justify-content-between align-items-center">
            <span class="badge bg-light text-dark border">
              <i class="bi bi-calendar-event"></i> <%= dateformat(r.job.deadline) %>
            </span>
            <a href="/jobs/<%= r.job.id %>" class="btn btn-primary btn-sm">View &amp; Apply</a>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
    <% } else { %>
    <div class="card shadow-sm">
      <div class="card-body text-muted">
        No job matches yet — add your skills in
        <a href="/profile/edit">Edit Profile</a> and browse the
        <a href="/jobs">Job Board</a>.
      </div>
    </div>
    <% } %>
  </section>

  <%- include('partials/profile_meter') %>

  <!-- ================= QUICK ACTIONS ================= -->
  <div class="row g-3">
    <div class="col-md-4 dash-anim" style="--i:0">
      <a href="/search" class="dash-action">
        <span class="dash-action-icon dash-action-blue"><i class="bi bi-search"></i></span>
        <span class="dash-action-text">
          <span class="dash-action-title">Find Members</span>
          <span class="dash-action-desc">Search alumni and faculty, view profiles and connect.</span>
        </span>
        <i class="bi bi-chevron-right dash-action-arrow"></i>
      </a>
    </div>
    <div class="col-md-4 dash-anim" style="--i:1">
      <a href="/jobs" class="dash-action">
        <span class="dash-action-icon dash-action-green"><i class="bi bi-briefcase"></i></span>
        <span class="dash-action-text">
          <span class="dash-action-title">Browse Jobs</span>
          <span class="dash-action-desc">See jobs posted by alumni and apply in one click.</span>
        </span>
        <i class="bi bi-chevron-right dash-action-arrow"></i>
      </a>
    </div>
    <div class="col-md-4 dash-anim" style="--i:2">
      <a href="/my-applications" class="dash-action">
        <span class="dash-action-icon dash-action-orange"><i class="bi bi-file-earmark-check"></i></span>
        <span class="dash-action-text">
          <span class="dash-action-title">Track Applications</span>
          <span class="dash-action-desc">Check whether you are Applied, Shortlisted or Rejected.</span>
        </span>
        <i class="bi bi-chevron-right dash-action-arrow"></i>
      </a>
    </div>
    <div class="col-md-4 dash-anim" style="--i:3">
      <a href="/chat" class="dash-action">
        <span class="dash-action-icon dash-action-sky"><i class="bi bi-chat-dots"></i></span>
        <span class="dash-action-text">
          <span class="dash-action-title">Messages</span>
          <span class="dash-action-desc">Chat with your connections and mentors.</span>
        </span>
        <i class="bi bi-chevron-right dash-action-arrow"></i>
      </a>
    </div>
    <div class="col-md-4 dash-anim" style="--i:4">
      <a href="/announcements" class="dash-action">
        <span class="dash-action-icon dash-action-red"><i class="bi bi-megaphone"></i></span>
        <span class="dash-action-text">
          <span class="dash-action-title">Announcements</span>
          <span class="dash-action-desc">Read the latest notices from faculty.</span>
        </span>
        <i class="bi bi-chevron-right dash-action-arrow"></i>
      </a>
    </div>
    <div class="col-md-4 dash-anim" style="--i:5">
      <a href="/notifications" class="dash-action">
        <span class="dash-action-icon dash-action-slate"><i class="bi bi-bell"></i></span>
        <span class="dash-action-text">
          <span class="dash-action-title">Notifications</span>
          <span class="dash-action-desc">Requests, new jobs and status updates in one place.</span>
        </span>
        <i class="bi bi-chevron-right dash-action-arrow"></i>
      </a>
    </div>
  </div>

</div>

<%- include('partials/footer') %>

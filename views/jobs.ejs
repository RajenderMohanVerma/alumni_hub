<%- include('partials/header', { title: 'Jobs' }) %>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
  <h2 class="fw-bold mb-0"><i class="bi bi-briefcase"></i> Job Board</h2>
  <% if (currentUser.role === 'alumni') { %>
  <a href="/jobs/new" class="btn btn-success">
    <i class="bi bi-plus-circle"></i> Post a Job
  </a>
  <% } else if (currentUser.role === 'student') { %>
  <a href="/my-applications" class="btn btn-outline-primary">
    <i class="bi bi-file-earmark-text"></i> My Applications
  </a>
  <% } %>
</div>

<!-- Live search: type to filter the job cards instantly (see /js/main.js) -->
<div class="card shadow-sm mb-3">
  <div class="card-body">
    <div class="input-group">
      <span class="input-group-text"><i class="bi bi-search"></i></span>
      <input id="liveSearch" type="text" class="form-control"
             placeholder="Start typing a job title, company or place — results filter live..."
             autocomplete="off">
    </div>
  </div>
</div>

<% /* Location filter chips: one chip per location present in the list.
      Clicking a chip filters the cards together with the search box
      (the logic lives in /js/main.js). */ %>
<% const locations = [...new Set(jobs.map(function(j) { return j.location; }).filter(Boolean))].sort(); %>
<% if (locations.length) { %>
<div class="d-flex flex-wrap align-items-center gap-2 mb-4" id="jobChips">
  <span class="text-muted small"><i class="bi bi-geo-alt"></i> Location:</span>
  <button type="button" class="filter-chip active" data-location="">All locations</button>
  <% locations.forEach(function(loc) { %>
  <button type="button" class="filter-chip" data-location="<%= loc %>"><%= loc %></button>
  <% }) %>
</div>
<% } %>

<% if (jobs.length) { %>
<div class="row g-3" id="cardGrid">
  <% jobs.forEach(function(job) { %>
  <div class="col-md-6 col-lg-4 filter-item reveal" data-location="<%= job.location || '' %>">
    <div class="card h-100 shadow-sm job-card">
      <div class="card-body">
        <h5 class="card-title fw-semibold"><%= job.title %></h5>
        <p class="card-subtitle text-muted mb-2">
          <i class="bi bi-building"></i> <%= job.company %>
          <% if (job.location) { %><br><i class="bi bi-geo-alt"></i> <%= job.location %><% } %>
        </p>
        <% if (job.salary) { %>
        <p class="mb-2"><span class="badge bg-success-subtle text-success-emphasis">
          <i class="bi bi-cash-stack"></i> <%= job.salary %></span></p>
        <% } %>
        <p class="card-text text-muted small">
          <%= job.description ? truncate(job.description, 100) : 'No description provided.' %>
        </p>
        <p class="card-text small text-muted mb-0">
          Posted by <%= job.poster_name %> · <%= datetimeformat(job.created_at) %>
        </p>
      </div>
      <div class="card-footer bg-white d-flex justify-content-between align-items-center">
        <span class="badge bg-light text-dark border">
          <i class="bi bi-calendar-event"></i> <%= dateformat(job.deadline) %>
        </span>
        <a href="/jobs/<%= job.id %>" class="btn btn-primary btn-sm">View &amp; Apply</a>
      </div>
    </div>
  </div>
  <% }) %>
</div>
<p id="noResults" class="text-muted d-none">No job matches your search.</p>
<% } else { %>
<div class="alert alert-info">No jobs posted yet. Check back soon!</div>
<% } %>

<%- include('partials/footer') %>

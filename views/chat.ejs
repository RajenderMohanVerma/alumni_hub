<%- include('partials/header', { title: 'Messages' }) %>

<h2 class="fw-bold mb-4"><i class="bi bi-chat-dots"></i> Messages</h2>

<% if (chats.length) { %>
<div class="list-group shadow-sm">
  <% chats.forEach(function(c) { %>
  <a href="/chat/<%= c.id %>"
     class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3">
    <img src="<%= avatarUrl(c) %>" alt="avatar" class="member-avatar">
    <div class="flex-grow-1 min-width-0">
      <div class="d-flex justify-content-between">
        <strong><%= c.name %></strong>
        <small class="text-muted"><%= c.last_time ? datetimeformat(c.last_time) : '' %></small>
      </div>
      <div class="text-muted text-truncate small">
        <%= c.last_message ? truncate(c.last_message, 70) : '' %>
      </div>
    </div>
    <% if (c.unread) { %>
    <span class="badge rounded-pill bg-danger"><%= c.unread %></span>
    <% } %>
  </a>
  <% }) %>
</div>
<% } else { %>
<div class="alert alert-info">
  No conversations yet. Visit a member's <a href="/search">profile</a> and
  click <strong>Message</strong> to start chatting.
</div>
<% } %>

<%- include('partials/footer') %>

<%- include('partials/header', { title: person.name }) %>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
          <img src="<%= avatarUrl(person) %>" alt="avatar" class="profile-avatar">
          <div class="flex-grow-1">
            <h3 class="fw-bold mb-0"><%= person.name %></h3>
            <span class="badge bg-primary"><%= capitalize(person.role) %></span>
            <% if (!person.is_active) { %><span class="badge bg-danger">Blocked</span><% } %>
            <p class="text-muted mb-0 mt-1">
              <i class="bi bi-envelope"></i> <%= person.email %>
              <% if (person.phone) { %> · <i class="bi bi-telephone"></i> <%= person.phone %><% } %>
            </p>
            <p class="text-muted small mb-0">Member since <%= person.created_at ? person.created_at.slice(0, 10) : '' %></p>
          </div>
          <% if (person.id === currentUser.id) { %>
            <a href="/profile/edit" class="btn btn-outline-primary">
              <i class="bi bi-pencil-square"></i> Edit Profile
            </a>
          <% } else { %>
            <div class="d-flex gap-2">
              <% if (connectionStatus === 'none' || connectionStatus === 'rejected') { %>
                <form method="post" action="/connect/<%= person.id %>"
                      class="js-connect-form" data-name="<%= person.name %>"
                      data-sent-html='<button class="btn btn-secondary" disabled><i class="bi bi-check-lg"></i> Request Sent</button>'>
                  <button class="btn btn-primary" type="submit">
                    <i class="bi bi-person-plus"></i> Connect
                  </button>
                </form>
              <% } else if (connectionStatus === 'pending_sent') { %>
                <button class="btn btn-secondary" disabled>
                  <i class="bi bi-check-lg"></i> Request Sent
                </button>
              <% } else if (connectionStatus === 'pending_received') { %>
                <a href="/connections" class="btn btn-warning">
                  <i class="bi bi-person-check"></i> Respond to Request
                </a>
              <% } else if (connectionStatus === 'accepted') { %>
                <span class="btn btn-success disabled">
                  <i class="bi bi-person-check-fill"></i> Connected
                </span>
              <% } %>
              <a href="/chat/<%= person.id %>" class="btn btn-outline-primary">
                <i class="bi bi-chat-dots"></i> Message
              </a>
            </div>
          <% } %>
        </div>

        <hr>

        <% if (profile) { %>
        <div class="row g-3">
          <% if (person.role === 'student') { %>
            <div class="col-md-6"><strong><i class="bi bi-book"></i> Course:</strong> <%= profile.course || '—' %></div>
            <div class="col-md-6"><strong><i class="bi bi-diagram-3"></i> Branch:</strong> <%= profile.branch || '—' %></div>
            <div class="col-md-6"><strong><i class="bi bi-calendar3"></i> Year:</strong> <%= profile.year || '—' %></div>
          <% } else if (person.role === 'alumni') { %>
            <div class="col-md-6"><strong><i class="bi bi-building"></i> Company:</strong> <%= profile.company || '—' %></div>
            <div class="col-md-6"><strong><i class="bi bi-person-badge"></i> Designation:</strong> <%= profile.designation || '—' %></div>
            <div class="col-md-6"><strong><i class="bi bi-briefcase"></i> Experience:</strong> <%= profile.experience || '—' %></div>
          <% } else if (person.role === 'faculty') { %>
            <div class="col-md-6"><strong><i class="bi bi-building"></i> Department:</strong> <%= profile.department || '—' %></div>
            <div class="col-md-6"><strong><i class="bi bi-person-badge"></i> Designation:</strong> <%= profile.designation || '—' %></div>
            <div class="col-md-6"><strong><i class="bi bi-award"></i> Qualification:</strong> <%= profile.qualification || '—' %></div>
          <% } %>
          <div class="col-12">
            <strong><i class="bi bi-lightning"></i> Skills:</strong>
            <% if (profile.skills) { %>
              <% profile.skills.split(',').forEach(function(skill) { %>
                <span class="badge bg-light text-dark border"><%= skill.trim() %></span>
              <% }) %>
            <% } else { %> — <% } %>
          </div>
          <div class="col-12">
            <strong><i class="bi bi-info-circle"></i> About:</strong>
            <p class="text-muted mb-0"><%= profile.bio || 'No bio added yet.' %></p>
          </div>
        </div>
        <% } else { %>
          <p class="text-muted mb-0">This user has not added profile details yet.</p>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>

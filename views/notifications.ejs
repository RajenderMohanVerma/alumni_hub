<%- include('partials/header', { title: 'Notifications' }) %>

<h2 class="fw-bold mb-4"><i class="bi bi-bell"></i> Notifications</h2>

<% if (notifications.length) { %>
<div class="list-group shadow-sm">
  <% notifications.forEach(function(n) { %>
    <% if (n.link) { %>
    <a href="<%= n.link %>" class="list-group-item list-group-item-action d-flex gap-3 py-3 <%= !n.is_read ? 'notification-unread' : '' %>">
    <% } else { %>
    <div class="list-group-item d-flex gap-3 py-3 <%= !n.is_read ? 'notification-unread' : '' %>">
    <% } %>
      <i class="bi bi-bell-fill text-primary fs-5"></i>
      <div class="flex-grow-1">
        <div><%= n.text %></div>
        <small class="text-muted"><%= datetimeformat(n.created_at) %></small>
      </div>
      <% if (!n.is_read) { %><span class="badge bg-danger align-self-center">New</span><% } %>
    <% if (n.link) { %></a><% } else { %></div><% } %>
  <% }) %>
</div>
<% } else { %>
<div class="alert alert-info">You have no notifications yet.</div>
<% } %>

<%- include('partials/footer') %>

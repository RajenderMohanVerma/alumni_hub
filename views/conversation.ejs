<%- include('partials/header', { title: 'Chat with ' + other.name }) %>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card shadow-sm">
      <!-- Chat header -->
      <div class="card-header bg-white d-flex align-items-center gap-3">
        <a href="/chat" class="btn btn-outline-secondary btn-sm">
          <i class="bi bi-arrow-left"></i>
        </a>
        <img src="<%= avatarUrl(other) %>" alt="avatar" class="member-avatar-sm">
        <div>
          <strong><%= other.name %></strong>
          <span class="badge bg-secondary"><%= capitalize(other.role) %></span>
          <div class="text-muted small"><%= other.email %></div>
        </div>
      </div>

      <!-- Messages -->
      <div class="card-body chat-box" id="chatBox">
        <% if (messages.length) { %>
          <% messages.forEach(function(m) { %>
            <% if (m.sender_id === currentUser.id) { %>
            <div class="d-flex justify-content-end mb-2">
              <div class="chat-bubble mine">
                <div><%= m.body %></div>
                <div class="chat-time"><%= datetimeformat(m.created_at) %></div>
              </div>
            </div>
            <% } else { %>
            <div class="d-flex justify-content-start mb-2">
              <div class="chat-bubble theirs">
                <div><%= m.body %></div>
                <div class="chat-time"><%= datetimeformat(m.created_at) %></div>
              </div>
            </div>
            <% } %>
          <% }) %>
        <% } else { %>
          <p class="text-center text-muted my-4">
            No messages yet. Say hello to <%= other.name.split(' ')[0] %>!
          </p>
        <% } %>
      </div>

      <!-- Send box -->
      <div class="card-footer bg-white">
        <form method="post" action="/chat/<%= other.id %>" class="d-flex gap-2">
          <input class="form-control" name="body" placeholder="Type a message..."
                 required autocomplete="off" autofocus>
          <button class="btn btn-primary" type="submit">
            <i class="bi bi-send"></i> Send
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>

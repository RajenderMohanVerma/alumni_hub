<%- include('partials/header', { title: 'Chat with ' + other.name }) %>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card shadow-sm chat-card">
      <!-- Chat header: back button, partner avatar + name, and a real
           detail from their profile (chatSubline, built by the route) -->
      <div class="chat-header">
        <a href="/chat" class="chat-back" aria-label="Back to all chats">
          <i class="bi bi-arrow-left"></i>
        </a>
        <a href="/profile/<%= other.id %>" class="chat-head-link">
          <img src="<%= avatarUrl(other) %>" alt="avatar" class="chat-head-avatar">
          <span class="chat-head-meta">
            <span class="chat-head-name">
              <%= other.name %>
              <span class="badge bg-<%= other.role === 'student' ? 'primary' : (other.role === 'alumni' ? 'success' : 'warning text-dark') %>"><%= capitalize(other.role) %></span>
            </span>
            <span class="chat-head-sub"><%= chatSubline %></span>
          </span>
        </a>
      </div>

      <!-- Messages: one bubble row per message. Consecutive messages
           from the same sender form a cluster (tighter spacing, the
           partner's mini avatar only under the last one), and a date
           separator appears whenever the day changes. -->
      <div class="chat-box" id="chatBox">
        <% if (messages.length) { %>
          <% var lastDay = null; %>
          <% messages.forEach(function(m, idx) { %>
            <% var day = (m.created_at || '').slice(0, 10); %>
            <% if (day && day !== lastDay) { lastDay = day; %>
              <div class="chat-day"><span><%= dateformat(m.created_at) %></span></div>
            <% } %>
            <% var mine = m.sender_id === currentUser.id; %>
            <% var next = messages[idx + 1]; %>
            <% var clusterEnd = !next || next.sender_id !== m.sender_id || (next.created_at || '').slice(0, 10) !== day; %>
            <div class="chat-row <%= mine ? 'mine' : 'theirs' %><%= clusterEnd ? '' : ' in-cluster' %>" style="--chat-i: <%= idx %>">
              <% if (!mine) { %>
                <% if (clusterEnd) { %>
                  <img src="<%= avatarUrl(other) %>" alt="avatar" class="chat-mini-avatar">
                <% } else { %>
                  <span class="chat-mini-spacer"></span>
                <% } %>
              <% } %>
              <div class="chat-bubble <%= mine ? 'mine' : 'theirs' %>">
                <div class="chat-text"><%= m.body %></div>
                <div class="chat-time"><%= timeformat(m.created_at) %></div>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <p class="text-center text-muted my-4">
            No messages yet. Say hello to <%= other.name.split(' ')[0] %>!
          </p>
        <% } %>
      </div>

      <!-- Composer: same form as always (POST, field "body") -->
      <div class="chat-composer">
        <form method="post" action="/chat/<%= other.id %>" class="chat-form">
          <input class="chat-input" name="body" placeholder="Type a message..."
                 required autocomplete="off" autofocus>
          <button class="chat-send" type="submit" aria-label="Send message">
            <i class="bi bi-send-fill"></i>
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>

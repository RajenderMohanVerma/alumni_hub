<%- include('../partials/header', { title: 'Manage Users' }) %>

<h2 class="fw-bold mb-4"><i class="bi bi-people"></i> Manage Users</h2>

<form method="get" action="/admin/users" class="mb-3">
  <div class="input-group" style="max-width:420px">
    <input class="form-control" name="q" placeholder="Search by name or email..."
           value="<%= q %>">
    <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i> Search</button>
  </div>
</form>

<div class="card shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>User</th>
          <th>Role</th>
          <th>Phone</th>
          <th>Joined</th>
          <th>Status</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(function(u) { %>
        <tr>
          <td>
            <div class="d-flex align-items-center gap-2">
              <img src="<%= avatarUrl(u) %>" alt="avatar" class="member-avatar-sm">
              <div>
                <a href="/profile/<%= u.id %>" class="fw-semibold text-decoration-none"><%= u.name %></a>
                <div class="text-muted small"><%= u.email %></div>
              </div>
            </div>
          </td>
          <td>
            <span class="badge bg-<%= u.role === 'admin' ? 'dark' : (u.role === 'student' ? 'primary' : (u.role === 'alumni' ? 'success' : 'warning text-dark')) %>">
              <%= capitalize(u.role) %>
            </span>
          </td>
          <td class="small"><%= u.phone || '—' %></td>
          <td class="small"><%= u.created_at ? u.created_at.slice(0, 10) : '' %></td>
          <td>
            <% if (u.is_active) { %>
              <span class="badge bg-success">Active</span>
            <% } else { %>
              <span class="badge bg-danger">Blocked</span>
            <% } %>
          </td>
          <td class="text-end">
            <% if (u.id !== currentUser.id) { %>
            <form method="post" action="/admin/users/<%= u.id %>/toggle" class="d-inline">
              <button class="btn btn-sm btn-<%= u.is_active ? 'warning' : 'success' %>" type="submit">
                <i class="bi bi-<%= u.is_active ? 'slash-circle' : 'check-circle' %>"></i>
                <%= u.is_active ? 'Block' : 'Unblock' %>
              </button>
            </form>
            <form method="post" action="/admin/users/<%= u.id %>/delete" class="d-inline">
              <button class="btn btn-sm btn-outline-danger js-confirm" type="submit"
                      data-confirm="Delete <%= u.name %> and all their data?">
                <i class="bi bi-trash"></i>
              </button>
            </form>
            <% } else { %>
            <span class="text-muted small">You</span>
            <% } %>
          </td>
        </tr>
        <% }) %>
        <% if (!users.length) { %>
        <tr><td colspan="6" class="text-center text-muted py-4">No users found.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>

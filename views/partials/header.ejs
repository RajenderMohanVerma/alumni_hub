<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · Alumni Hub</title>
  <!-- Bootstrap 5 CSS (CDN) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <!-- Our own small stylesheet -->
  <link href="/css/style.css" rel="stylesheet">
  <!-- PWA: web app manifest + theme colour, so phones can install
       Alumni Hub on the home screen (see /sw.js and /js/main.js) -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#2563eb">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="Alumni Hub">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
</head>
<body class="d-flex flex-column min-vh-100<%= currentUser ? ' has-mobile-nav' : '' %>" data-section="<%= navSection %>">

<!-- ======================= NAVBAR ======================= -->
<nav id="mainNavbar" class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm sticky-top">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/">
      <i class="bi bi-mortarboard-fill"></i> Alumni Hub
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
            data-bs-target="#mainNav" aria-controls="mainNav"
            aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="mainNav">
      <!-- Common links: visible to everyone, guest or logged in -->
      <ul class="navbar-nav me-auto">
        <li class="nav-item">
          <a class="nav-link <%= navSection === 'home' ? 'active' : '' %>" href="/">Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= navSection === 'about' ? 'active' : '' %>" href="/about">About</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= navSection === 'services' ? 'active' : '' %>" href="/services">Services</a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= navSection === 'contact' ? 'active' : '' %>" href="/contact">Contact</a>
        </li>
      </ul>

      <% if (currentUser) { %>
      <!-- Links for logged-in users -->
      <ul class="navbar-nav ms-auto align-items-lg-center">
        <li class="nav-item">
          <a class="nav-link <%= navSection === 'dashboard' ? 'active' : '' %>" href="/dashboard">
            <i class="bi bi-speedometer2"></i> Dashboard
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= navSection === 'members' ? 'active' : '' %>" href="/search">
            <i class="bi bi-people"></i> Members
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= navSection === 'connections' ? 'active' : '' %>" href="/connections">
            <i class="bi bi-person-plus"></i> Connections
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link position-relative <%= navSection === 'chat' ? 'active' : '' %>" href="/chat">
            <i class="bi bi-chat-dots"></i> Chat
            <% if (unreadMessages) { %>
            <span class="badge rounded-pill bg-danger badge-dot"><%= unreadMessages %></span>
            <% } %>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= navSection === 'jobs' ? 'active' : '' %>" href="/jobs">
            <i class="bi bi-briefcase"></i> Jobs
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link <%= navSection === 'announcements' ? 'active' : '' %>" href="/announcements">
            <i class="bi bi-megaphone"></i> Announcements
          </a>
        </li>
        <% if (currentUser.role === 'admin') { %>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle <%= navSection.startsWith('admin') ? 'active' : '' %>" href="#"
             role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-shield-lock"></i> Admin
          </a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="/admin"><i class="bi bi-speedometer2"></i> Admin Dashboard</a></li>
            <li><a class="dropdown-item" href="/admin/users"><i class="bi bi-people"></i> Manage Users</a></li>
            <li><a class="dropdown-item" href="/admin/jobs"><i class="bi bi-briefcase"></i> Manage Jobs</a></li>
            <li><a class="dropdown-item" href="/admin/messages"><i class="bi bi-envelope"></i> Contact Messages</a></li>
          </ul>
        </li>
        <% } %>
        <li class="nav-item">
          <a class="nav-link position-relative <%= navSection === 'notifications' ? 'active' : '' %>" href="/notifications"
             title="Notifications">
            <i class="bi bi-bell"></i>
            <% if (unreadNotifications) { %>
            <span class="badge rounded-pill bg-danger badge-dot"><%= unreadNotifications %></span>
            <% } %>
          </a>
        </li>
        <!-- Profile dropdown -->
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#"
             role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <img src="<%= avatarUrl(currentUser) %>" alt="avatar" class="avatar avatar-sm me-1">
            <span><%= currentUser.name.split(' ')[0] %></span>
          </a>
          <ul class="dropdown-menu dropdown-menu-end">
            <li>
              <span class="dropdown-item-text small text-muted">
                <%= currentUser.email %><br>
                <span class="badge bg-secondary"><%= capitalize(currentUser.role) %></span>
              </span>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item" href="/profile/<%= currentUser.id %>"><i class="bi bi-person"></i> My Profile</a></li>
            <li><a class="dropdown-item" href="/profile/edit"><i class="bi bi-pencil-square"></i> Edit Profile</a></li>
            <% if (currentUser.role === 'student') { %>
            <li><a class="dropdown-item" href="/my-applications"><i class="bi bi-file-earmark-text"></i> My Applications</a></li>
            <% } %>
            <% if (currentUser.role === 'alumni') { %>
            <li><a class="dropdown-item" href="/my-jobs"><i class="bi bi-briefcase"></i> My Jobs</a></li>
            <% } %>
            <li><a class="dropdown-item" href="/change-password"><i class="bi bi-key"></i> Change Password</a></li>
            <li><hr class="dropdown-divider"></li>
            <li><a class="dropdown-item" href="/logout"><i class="bi bi-box-arrow-right"></i> Logout</a></li>
          </ul>
        </li>
      </ul>
      <% } else { %>
      <!-- Links for guests (login/register live on the Python auth service) -->
      <ul class="navbar-nav ms-auto">
        <li class="nav-item">
          <a class="nav-link" href="/login"><i class="bi bi-box-arrow-in-right"></i> Login</a>
        </li>
        <li class="nav-item">
          <a class="btn btn-light btn-sm mt-1 ms-lg-2 fw-semibold" href="/register">Register</a>
        </li>
      </ul>
      <% } %>
    </div>
  </div>
</nav>

<!-- ======================= FLASH MESSAGES ======================= -->
<div class="container mt-3">
  <% if (flash) { %>
  <div class="toast show align-items-center text-bg-<%= flash.type === 'error' ? 'danger' : flash.type %> border-0 mb-2"
       role="alert" aria-live="assertive" aria-atomic="true">
    <div class="d-flex">
      <div class="toast-body"><%= flash.message %></div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto"
              data-bs-dismiss="toast" aria-label="Close"></button>
    </div>
  </div>
  <% } %>
</div>

<!-- ======================= PAGE CONTENT ======================= -->
<main class="container pb-5 flex-grow-1">

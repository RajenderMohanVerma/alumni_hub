  <a href="/dashboard" class="mobile-nav-link" data-nav="dashboard">
    <i class="bi bi-speedometer2"></i><span>Dashboard</span>
  </a>
  <a href="/search" class="mobile-nav-link" data-nav="members">
    <i class="bi bi-people"></i><span>Members</span>
  </a>

<!-- ============ BACK TO TOP (appears after scrolling) ============ -->
<button id="backToTop" class="back-to-top" type="button" aria-label="Back to top">
  <i class="bi bi-arrow-up"></i>
</button>

<!-- ============ INSTALL APP BANNER (PWA, mobile only) ============
     Hidden by default; /js/main.js shows it on phones when the app
     can be installed and it was not dismissed in the last 7 days. -->
<div id="installBanner" class="install-banner<%= currentUser ? ' above-nav' : '' %>" hidden>
  <img src="/images/icon.svg" alt="" class="install-icon">
  <div class="install-text">
    <strong>Install Alumni Hub</strong>
    <small>Add it to your home screen — it opens like an app, full screen.</small>
    <div class="install-steps" id="installSteps" hidden>
      In your browser menu choose <strong>Install app</strong> / <strong>Add to
      Home screen</strong>. On iPhone (Safari): tap
      <i class="bi bi-box-arrow-up"></i> <strong>Share</strong>, then
      <strong>Add to Home Screen</strong>.
    </div>
  </div>
  <button id="installBtn" class="btn btn-primary btn-sm flex-shrink-0" type="button">Install</button>
  <button id="installClose" class="btn-close install-close" type="button" aria-label="Dismiss"></button>
</div>


<%- include('partials/header', { title: 'Members' }) %>

<!-- ======================= PAGE HEAD ======================= -->
<div class="mem-head">
  <h2 class="fw-bold mb-0"><i class="bi bi-people"></i> Member Directory</h2>
  <span class="mem-count-chip">
    <i class="bi bi-people-fill"></i> <%= members.length %> members
  </span>
</div>

<!-- Live search: type to filter the cards instantly (see /js/main.js) -->
<div class="mem-search-card">
  <div class="input-group mem-search-group">
    <span class="input-group-text"><i class="bi bi-search"></i></span>
    <input id="liveSearch" type="text" class="form-control"
           placeholder="Start typing a name, email or skill — results filter live..."
           autocomplete="off">
  </div>
</div>

<!-- Role filter pills (server-side filter, one link per role) + sort
     order (sort runs in the browser, see /js/main.js; the cards carry
     data-name / data-joined) -->
<div class="mem-controls">
  <div class="mem-pills" role="group" aria-label="Filter by role">
    <a href="/search" class="mem-pill <%= !role ? 'active' : '' %>">
      All <span class="mem-pill-count"><%= counts.all %></span>
    </a>
    <a href="/search?role=student" class="mem-pill <%= role === 'student' ? 'active' : '' %>">
      Students <span class="mem-pill-count"><%= counts.student %></span>
    </a>
    <a href="/search?role=alumni" class="mem-pill <%= role === 'alumni' ? 'active' : '' %>">
      Alumni <span class="mem-pill-count"><%= counts.alumni %></span>
    </a>
    <a href="/search?role=faculty" class="mem-pill <%= role === 'faculty' ? 'active' : '' %>">
      Faculty <span class="mem-pill-count"><%= counts.faculty %></span>
    </a>
  </div>
  <div class="mem-sort-wrap">
    <label for="memberSort" class="form-label mb-0 small text-muted">
      <i class="bi bi-sort-down"></i> Sort by
    </label>
    <select id="memberSort" class="form-select form-select-sm mem-sort">
      <option value="name" selected>Name (A–Z)</option>
      <option value="newest">Newest first</option>
    </select>
  </div>
</div>

<% if (members.length) { %>
<div class="row g-3" id="cardGrid">
  <% members.forEach(function(m, idx) { %>
  <%
    // One context line per role, built from the profile fields the
    // route loaded: student -> course · branch, alumni -> designation ·
    // company, faculty -> designation · department.
    var contextParts = [];
    if (m.role === 'student') {
      if (m.course) contextParts.push(m.course);
      if (m.branch) contextParts.push(m.branch);
    } else if (m.role === 'alumni') {
      if (m.designation) contextParts.push(m.designation);
      if (m.company) contextParts.push(m.company);
    } else if (m.role === 'faculty') {
      if (m.designation) contextParts.push(m.designation);
      if (m.department) contextParts.push(m.department);
    }
    var skillList = m.skills
      ? m.skills.split(',').map(function(s) { return s.trim(); }).filter(Boolean)
      : [];
  %>
  <div class="col-md-6 col-lg-4 filter-item reveal" style="--i:<%= idx % 9 %>"
       data-name="<%= m.name.toLowerCase() %>" data-joined="<%= m.created_at || '' %>">
    <div class="card h-100 mem-card">
      <div class="card-body">
        <div class="d-flex align-items-center gap-3 mb-2">
          <img src="<%= avatarUrl(m) %>" alt="avatar" class="mem-avatar">
          <div class="mem-id">
            <h5 class="card-title mb-1">
              <a href="/profile/<%= m.id %>" class="text-decoration-none"><%= m.name %></a>
            </h5>
            <span class="badge badge-role-<%= m.role %>">
              <%= capitalize(m.role) %>
            </span>
          </div>
        </div>
        <% if (contextParts.length) { %>
        <p class="mem-context mb-1">
          <i class="bi bi-briefcase"></i> <%= contextParts.join(' · ') %>
        </p>
        <% } %>
        <p class="mem-email mb-2">
          <i class="bi bi-envelope"></i> <%= m.email %>
        </p>
        <% if (skillList.length) { %>
        <p class="mem-skills mb-2">
          <% skillList.slice(0, 4).forEach(function(skill) { %>
            <span class="mem-chip"><%= skill %></span>
          <% }) %>
          <% if (skillList.length > 4) { %>
            <span class="mem-chip mem-chip-more">+<%= skillList.length - 4 %> more</span>
          <% } %>
        </p>
        <% } %>
        <% if (m.bio) { %>
        <p class="mem-bio mb-0"><%= m.bio %></p>
        <% } %>
      </div>
      <div class="card-footer mem-actions">
        <a href="/profile/<%= m.id %>" class="btn btn-outline-primary mem-action mem-action-view">
          <i class="bi bi-person"></i> View Profile
        </a>
        <% if (statuses[m.id] === 'none' || statuses[m.id] === 'rejected') { %>
          <!-- With JS this form is submitted by fetch and the button
               updates in place (see /js/main.js, section 11); without
               JS it posts + redirects exactly as it always has. -->
          <form method="post" action="/connect/<%= m.id %>"
                class="js-connect-form mem-action-form" data-name="<%= m.name %>">
            <button class="btn btn-primary mem-action" type="submit">
              <i class="bi bi-person-plus"></i> Connect
            </button>
          </form>
        <% } else if (statuses[m.id] === 'pending_sent') { %>
          <button type="button" class="btn btn-secondary mem-action" disabled><i class="bi bi-check-lg"></i> Request Sent</button>
        <% } else if (statuses[m.id] === 'pending_received') { %>
          <a href="/connections" class="btn btn-warning mem-action">Respond</a>
        <% } else if (statuses[m.id] === 'accepted') { %>
          <a href="/chat/<%= m.id %>" class="btn btn-success mem-action">
            <i class="bi bi-chat-dots"></i> Chat
          </a>
        <% } %>
      </div>
    </div>
  </div>
  <% }) %>
</div>
<p id="noResults" class="mem-noresults d-none">
  <i class="bi bi-search"></i>
  No member matches your search. Try a different name, email or skill.
</p>
<% } else { %>
<div class="alert alert-info">No members found.</div>
<% } %>

<!-- In-place action toasts (connect requests) are built here by
     /js/main.js section 11; the box itself is just a fixed corner. -->
<div id="memToastBox" class="mem-toast-box" aria-live="polite"></div>

<%- include('partials/footer') %>
